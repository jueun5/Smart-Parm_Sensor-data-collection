const db = require('../config/db');

// 센서 데이터 저장
exports.saveSensorData = async (req, res) => {
    try {
        const {
            greenhouse_id,
            temperature,
            humidity,
            light_intensity,
            soil_moisture
        } = req.body;

        // 1. 필수 데이터 확인
        if (greenhouse_id === undefined || greenhouse_id === null) {
            return res.status(400).json({
                success: false,
                message: '온실 ID가 필요합니다.'
            });
        }

        // 2. 데이터 형식 및 범위 검사
        const greenhouseId = Number(greenhouse_id);

        if (!Number.isInteger(greenhouseId) || greenhouseId <= 0) {
            return res.status(400).json({
                success: false,
                message: '온실 ID가 올바르지 않습니다.'
            });
        }

        const readings = {
            temperature,
            humidity,
            light_intensity,
            soil_moisture
        };

        // 최소 한 개 이상의 센서 값 필요
        const hasValue = Object.values(readings).some(
            value => value !== undefined && value !== null
        );

        if (!hasValue) {
            return res.status(400).json({
                success: false,
                message: '센서 데이터가 없습니다.'
            });
        }

        // 숫자 형식 및 기본 범위 검사
        const limits = {
            temperature: [-50, 100],
            humidity: [0, 100],
            light_intensity: [0, 200000],
            soil_moisture: [0, 100]
        };

        for (const [key, value] of Object.entries(readings)) {
            if (value === undefined || value === null) continue;

            if (
                typeof value !== 'number' ||
                !Number.isFinite(value) ||
                value < limits[key][0] ||
                value > limits[key][1]
            ) {
                return res.status(400).json({
                    success: false,
                    message: `${key} 값이 올바르지 않습니다.`
                });
            }
        }

        // 3. DB에 데이터 저장
        const sql = `
            INSERT INTO sensor_data (
                greenhouse_id,
                temperature,
                humidity,
                light_intensity,
                soil_moisture,
                measured_at
            )
            VALUES (?, ?, ?, ?, ?, NOW())
        `;

        const values = [
            greenhouseId,
            temperature ?? null,
            humidity ?? null,
            light_intensity ?? null,
            soil_moisture ?? null
        ];

        const [result] = await db.execute(sql, values);

        // 4. 저장 결과 반환
        res.status(201).json({
            success: true,
            message: '센서 데이터가 저장되었습니다.',
            sensor_data_id: result.insertId
        });

    } catch (error) {
        console.error('센서 데이터 저장 오류:', error);

        res.status(500).json({
            success: false,
            message: '센서 데이터 저장 중 오류가 발생했습니다.'
        });
    }
};


// 최근 센서 데이터 조회
exports.getSensorData = async (req, res) => {
    try {
        const greenhouseId = Number(req.params.greenhouse_id);

        if (!Number.isInteger(greenhouseId) || greenhouseId <= 0) {
            return res.status(400).json({
                success: false,
                message: '온실 ID가 올바르지 않습니다.'
            });
        }

        const sql = `
            SELECT *
            FROM sensor_data
            WHERE greenhouse_id = ?
            ORDER BY measured_at DESC
            LIMIT 100
        `;

        const [rows] = await db.execute(sql, [greenhouseId]);

        res.status(200).json({
            success: true,
            count: rows.length,
            data: rows
        });

    } catch (error) {
        console.error('센서 데이터 조회 오류:', error);

        res.status(500).json({
            success: false,
            message: '센서 데이터 조회 중 오류가 발생했습니다.'
        });
    }
};
